{
  "permissions": {
    "allow": [
      "Bash(npx next:*)",
      "Bash(npx tsc:*)",
      "Bash(xargs ls:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python .claude/hooks/update_changelog.py"
          }
        ]
      }
    ]
  }
}