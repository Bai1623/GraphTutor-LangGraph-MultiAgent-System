{
  "permissions": {
    "allow": [
      "Bash(npx next:*)",
      "Bash(npx tsc:*)",
      "Bash(xargs ls:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python -c \"import subprocess,datetime; h=subprocess.run(['git','log','-1','--format=%h'],capture_output=True,text=True).stdout.strip(); d=subprocess.run(['git','log','-1','--format=%as'],capture_output=True,text=True).stdout.strip(); m=subprocess.run(['git','log','-1','--format=%s'],capture_output=True,text=True).stdout.strip(); lines=open('CHANGES.md',encoding='utf-8').readlines(); lines.insert(2,f'| {d} | \\`{h}\\` | {m} |\\n'); open('CHANGES.md','w',encoding='utf-8').writelines(lines)\""
          }
        ]
      }
    ]
  }
}