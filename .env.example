# ── LLM API Keys ──────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# SiliconFlow (embedding, reranker, supervisor, fallback)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Multimodal OCR (OpenAI-compatible vision model)
OCR_API_KEY=your_ocr_api_key_here
OCR_BASE_URL=https://api.siliconflow.cn/v1
OCR_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
OCR_MAX_IMAGE_MB=8
OCR_TIMEOUT_SECONDS=60

# Exam document/question MCP (optional for images, required for PDF/DOCX)
# Configure either DOCUMENT_MCP_URL or DOCUMENT_MCP_COMMAND.
DOCUMENT_MCP_URL=
DOCUMENT_MCP_COMMAND=
DOCUMENT_MCP_TIMEOUT_SECONDS=60
DOCUMENT_PARSE_MAX_FILE_MB=25
DOCUMENT_PARSE_MAX_FILES=12
UPLOAD_TASK_TIMEOUT_SECONDS=180
UPLOAD_MAX_UNCOMPRESSED_MB=100
UPLOAD_MAX_COMPRESSION_RATIO=100
# Optional antivirus scanner command. Example: clamscan --no-summary
UPLOAD_AV_COMMAND=
UPLOAD_AV_TIMEOUT_SECONDS=30
PDF_PARSE_MCP_TOOL=pdf_parse
DOCX_PARSE_MCP_TOOL=docx_parse
IMAGE_OCR_MCP_TOOL=image_ocr_plus
QUESTION_SEGMENTER_MCP_TOOL=question_segmenter

# Official policy/admission MCP (optional)
# Prefer official policy/admission data in planning; falls back to Web search when empty/failed.
# Configure either POLICY_MCP_URL or POLICY_MCP_COMMAND.
POLICY_MCP_URL=
POLICY_MCP_COMMAND=
POLICY_MCP_TOOL=policy_search
POLICY_MCP_TIMEOUT_SECONDS=10

# ── RAG ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_store/
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Fallback LLM ──────────────────────────────────────────
FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
FALLBACK_API_KEY=your_siliconflow_api_key_here
FALLBACK_BASE_URL=https://api.siliconflow.cn/v1

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_PASSWORD=tutor_dev

# ── CORS & Frontend ───────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Simple private login (change AUTH_SECRET before exposing to the internet)
AUTH_USERNAME=admin
AUTH_PASSWORD=123456
AUTH_SECRET=replace_with_a_long_random_string
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# ── Daily user quota ─────────────────────────────────────
# Applies per authenticated user and resets daily.
QUOTA_ENABLED=true
QUOTA_DAILY_REQUESTS=200
QUOTA_DAILY_TOKENS=300000
QUOTA_DAILY_UPLOADS=50
QUOTA_DAILY_RETRIES=30

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_SERVICE_NAME=gaokao-tutor
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACING_ENABLED=true
